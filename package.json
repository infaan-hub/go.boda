{
  "name": "go-boda-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Go.boda — Unguja Island Bodaboda & Bajaji Ride-Hailing Platform (Next.js PWAs + Microservices)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:apps": "turbo run dev --filter=./apps/* --parallel",
    "dev:gateway": "turbo run dev --filter=@goboda/api-gateway",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:bootstrap": "pnpm --filter @goboda/db db:bootstrap",
    "db:migrate:phase1": "pnpm --filter @goboda/db db:migrate:phase1",
    "db:migrate:phase2": "pnpm --filter @goboda/db db:migrate:phase2",
    "db:migrate:phase3": "pnpm --filter @goboda/db db:migrate:phase3",
    "db:migrate:phase4": "pnpm --filter @goboda/db db:migrate:phase4",
    "db:migrate:phase5": "pnpm --filter @goboda/db db:migrate:phase5",
    "db:seed:admin": "node scripts/seed-pilot-admin.mjs",
    "test:phase1": "node scripts/test-phase1.mjs",
    "test:phase2": "node scripts/test-phase2.mjs",
    "test:phase3": "node scripts/test-phase3.mjs",
    "test:phase4": "node scripts/test-phase4.mjs",
    "test:phase5": "node scripts/test-phase5.mjs",
    "test:phase6": "node scripts/test-phase6.mjs",
    "test:phase7": "node scripts/test-phase7-e2e.mjs",
    "test:phase8": "node scripts/test-phase8.mjs",
    "test:e2e": "node scripts/test-phase7-e2e.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
