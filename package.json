{
  "name": "go-boda-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Go.boda — Unguja Island Bodaboda & Bajaji ride platform (modular monolith)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @goboda/monolith dev",
    "build": "pnpm --filter @goboda/monolith... build",
    "typecheck": "pnpm --filter @goboda/shared-types build && pnpm --filter @goboda/i18n build && pnpm --filter @goboda/logger build && pnpm --filter @goboda/ui build && pnpm --filter @goboda/db build && pnpm --filter @goboda/events build && pnpm --filter @goboda/monolith typecheck",
    "lint": "pnpm --filter @goboda/monolith lint",
    "clean": "pnpm --filter @goboda/monolith clean",
    "db:bootstrap": "pnpm --filter @goboda/db db:bootstrap",
    "db:migrate:phase1": "pnpm --filter @goboda/db db:migrate:phase1",
    "db:migrate:phase2": "pnpm --filter @goboda/db db:migrate:phase2",
    "db:migrate:phase3": "pnpm --filter @goboda/db db:migrate:phase3",
    "db:migrate:phase4": "pnpm --filter @goboda/db db:migrate:phase4",
    "db:migrate:phase5": "pnpm --filter @goboda/db db:migrate:phase5",
    "db:migrate:phase6": "pnpm --filter @goboda/db db:migrate:phase6",
    "db:migrate:phase9": "pnpm --filter @goboda/db db:migrate:phase9",
    "db:migrate:phase10": "pnpm --filter @goboda/db db:migrate:phase10",
    "db:migrate:phase11": "pnpm --filter @goboda/db db:migrate:phase11",
    "db:seed:admin": "node scripts/seed-pilot-admin.mjs",
    "test:phase1": "pnpm typecheck && node --import tsx scripts/test-phase1.mjs",
    "test:phase2": "pnpm typecheck && node --import tsx scripts/test-phase2.mjs",
    "test:phase3": "pnpm typecheck && node --import tsx scripts/test-phase3.mjs",
    "test:phase4": "pnpm typecheck && node --import tsx scripts/test-phase4.mjs",
    "test:phase5": "pnpm typecheck && node --import tsx scripts/test-phase5.mjs",
    "test:phase6": "pnpm typecheck && node --import tsx scripts/test-phase6.mjs",
    "test:phase7": "pnpm typecheck && node --import tsx scripts/test-phase7-e2e.mjs",
    "test:phase8": "pnpm typecheck && pnpm build && node --import tsx scripts/test-phase8.mjs",
    "test:phase9": "pnpm typecheck && pnpm build && node --import tsx scripts/test-phase9.mjs",
    "test:routes": "pnpm typecheck && pnpm build && node scripts/test-routes-no-404.mjs",
    "test:auth": "pnpm typecheck && pnpm build && node scripts/test-auth-flows.mjs",
    "test:e2e": "pnpm typecheck && node --import tsx scripts/test-phase7-e2e.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
