{
  "name": "@goboda/trip-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@goboda/db": "workspace:*",
    "@goboda/events": "workspace:*",
    "@goboda/logger": "workspace:*",
    "@goboda/shared-types": "workspace:*",
    "fastify": "^5.2.2",
    "jose": "^6.0.10",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
