# Go.boda single Next.js + Fastify monolith
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# One Neon PostgreSQL database may serve all domain schemas. Optional role-specific
# URLs can remain when migrating existing data gradually.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/neondb?sslmode=require
AUTH_DATABASE_URL=
CUSTOMER_DATABASE_URL=
ADMIN_DATABASE_URL=
PARTNER_DATABASE_URL=

# Authentication and internal API security
JWT_SECRET=replace-with-a-strong-random-secret
ADMIN_JWT_SECRET=
PARTNER_JWT_SECRET=
INTERNAL_SERVICE_SECRET=replace-with-a-strong-random-secret
OTP_DEV_ECHO=false
OTP_SKIP_COOLDOWN=false

# Maps and routing
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
OSRM_BASE_URL=https://router.project-osrm.org

# Push notifications and external providers
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@goboda.co.tz
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox

# Private KYC storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KYC_BUCKET=goboda-kyc-private

# Payment providers
PAYMENT_WEBHOOK_SECRET=
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
