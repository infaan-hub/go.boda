# ==============================================================================
# Go.boda — Local Development Environment Variables (Unguja Island, Zanzibar)
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info

# Frontend App Public URLs
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_WS_LOCATION_URL=ws://localhost:4004
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000
NEXT_PUBLIC_PARTNER_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002

# API Gateway (Port 4000)
API_GATEWAY_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
INTERNAL_SERVICE_SECRET=replace-with-strong-internal-secret

# Downstream Microservice Base URLs
AUTH_SERVICE_URL=http://localhost:4001
OPERATOR_SERVICE_URL=http://localhost:4002
GEO_ZONE_SERVICE_URL=http://localhost:4003
LOCATION_SERVICE_URL=http://localhost:4004
PRICING_SERVICE_URL=http://localhost:4005
DISPATCH_SERVICE_URL=http://localhost:4006
TRIP_SERVICE_URL=http://localhost:4007
PAYMENT_WALLET_SERVICE_URL=http://localhost:4008
NOTIFICATION_SERVICE_URL=http://localhost:4009
SAFETY_SERVICE_URL=http://localhost:4010

# PostgreSQL 16 + PostGIS (Isolated DB per Microservice)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=goboda
POSTGRES_PASSWORD=goboda_dev_password
AUTH_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/auth_db
OPERATOR_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/operator_db
GEO_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/geo_db
LOCATION_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/location_db
PRICING_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/pricing_db
DISPATCH_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/dispatch_db
TRIP_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/trip_db
FINANCE_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/finance_db
NOTIF_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/notif_db
SAFETY_DATABASE_URL=postgresql://goboda:goboda_dev_password@localhost:5432/safety_db

# Redis 7 (Geospatial Index, Atomic Dispatch Locks, Pub/Sub, BullMQ)
REDIS_URL=redis://localhost:6379

# Event Bus (NATS JetStream)
NATS_URL=nats://localhost:4222

# Maps & Routing (MapLibre GL + OpenStreetMap / OSRM)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
OSRM_BASE_URL=https://router.project-osrm.org

# Web Push (VAPID Keys — generate via `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@goboda.co.tz

# External Providers (Phase 1+ / Phase 5+)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KYC_BUCKET=goboda-kyc-private
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
