{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "PORT",
    "API_GATEWAY_PORT",
    "CORS_ALLOWED_ORIGINS",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "AUTH_DATABASE_URL",
    "OPERATOR_DATABASE_URL",
    "GEO_DATABASE_URL",
    "LOCATION_DATABASE_URL",
    "PRICING_DATABASE_URL",
    "DISPATCH_DATABASE_URL",
    "TRIP_DATABASE_URL",
    "FINANCE_DATABASE_URL",
    "NOTIF_DATABASE_URL",
    "SAFETY_DATABASE_URL",
    "JWT_SECRET",
    "INTERNAL_SERVICE_SECRET",
    "AUTH_SERVICE_URL",
    "OPERATOR_SERVICE_URL",
    "GEO_ZONE_SERVICE_URL",
    "LOCATION_SERVICE_URL",
    "PRICING_SERVICE_URL",
    "DISPATCH_SERVICE_URL",
    "TRIP_SERVICE_URL",
    "PAYMENT_WALLET_SERVICE_URL",
    "NOTIFICATION_SERVICE_URL",
    "SAFETY_SERVICE_URL",
    "OSRM_BASE_URL",
    "INCLUDE_DEMO_FLEET",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_PHONE_NUMBER_ID",
    "AFRICASTALKING_API_KEY",
    "AFRICASTALKING_USERNAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
